# Config web de tu proyecto de Firebase (Firebase Console > Configuración del proyecto > tus apps > SDK setup and configuration).
# Copiá este archivo a ".env" y completá los valores. ".env" nunca se sube al repositorio.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
